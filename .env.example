# Path to the OKF bundle directory the agent manages
BUNDLE_ROOT=./sample-bundle

# ── Primary model ──────────────────────────────────────────────────────
# Any OpenAI-compatible or Anthropic-compatible API endpoint.
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_API_FORMAT=openai          # "openai" | "anthropic"
LLM_MODEL=                     # model id to request, e.g. "deepseek-chat" or "claude-sonnet-5"

# ── Fallback model (optional) ──────────────────────────────────────────
# Used when the primary model fails with a retryable error (timeout, 5xx).
# Leave LLM_FALLBACK_API_BASE_URL empty to disable fallback.
LLM_FALLBACK_API_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_API_FORMAT=openai
LLM_FALLBACK_MODEL=
# LLM_FALLBACK_ALLOW_FOR=query   # optional: restrict to read-only operations
# LLM_FALLBACK_RETRY_429=true    # optional: also fall back when the primary is rate-limited

# ── Removed in this fork ───────────────────────────────────────────────
# LLM_PROVIDER and the per-provider keys (ANTHROPIC_API_KEY,
# OPENROUTER_API_KEY, DEEPSEEK_API_KEY, LLAMACPP_BASE_URL, LLAMACPP_API_KEY,
# LOCAL_BASE_URL, LOCAL_API_KEY) no longer exist. Setting any of them is now
# a startup error, not a silent fallback. Use the LLM_API_* vars above.
# (docker-compose.yml no longer forwards them, so in Docker they are ignored.)

# Commit bundle changes to git after each mutation. On by default in this
# fork: mutation rollback undoes failed runs, git is what lets you undo a run
# that "succeeded" but wrote something wrong. Requires git in PATH (the
# official Docker image ships it); a bundle that is not yet a repo is
# initialized automatically, and the server refuses to start if autocommit is
# requested but cannot work.
GIT_AUTOCOMMIT=true

# All-or-nothing mutations: every write in an agent run is journalled and
# reverted if the run fails. Set false to restore upstream behaviour, where a
# model that dies mid-run leaves its partial writes on disk.
#MUTATION_ROLLBACK=true

# Host directory docker-compose.yml mounts at /bundle. Put your real path in .env
# (gitignored) so pulling updates never touches your deployment. Default: the sample.
#BUNDLE_PATH=/srv/understory/bundle

PORT=3800

# Optional total deadline for one query/mutation model run (e.g. 300s, 10m, 2h).
# Unset = no deadline: local models routinely take many minutes per run.
# A disconnecting client always cancels its in-flight model work regardless.
# The HTTP transport adds no limit of its own, so a model that never answers
# holds its run (and the dream scheduler) until this deadline, if one is set.
#LLM_TIMEOUT=30m

# How many steps one agent run (query, add/update, dream, chat turn) may take.
# A step is one model call plus the tools it asks for. A run that uses every
# step is stopped and reported as unfinished, never as a success. Large
# bundles and dreams with a lot to consolidate need more than the default.
#AGENT_MAX_STEPS=12

# Profiles: host several isolated memories on one server. Each profile is a
# bundle under PROFILES_ROOT with its own API key, and the key a request
# carries decides which memory it reaches. Takes precedence over BUNDLE_ROOT;
# AUTH_TOKEN is not used in this mode. Manage profiles with
# `node server/dist/profiles-cli.js` (or the /admin API when ADMIN_TOKEN is set).
#PROFILES_ROOT=/profiles
#ADMIN_TOKEN=

# Optional: require "Authorization: Bearer <token>" on /mcp and /api.
# Unset = open (fine for localhost/LAN). Set this before exposing understory anywhere.
#AUTH_TOKEN=
# Refuse to start when AUTH_TOKEN is unset, so a lost .env can't silently
# expose an open server. Recommended anywhere beyond localhost.
#AUTH_REQUIRED=true

# Query cache: repeated memory_query questions answer from cache until the
# bundle changes. QUERY_CACHE=false disables; QUERY_CACHE_TTL e.g. "1h" (default 24h).
#QUERY_CACHE=true
#QUERY_CACHE_TTL=24h

# Hot memory: recent writes + recent answers form a working set that queries
# check with one cheap tool-free LLM call before the full agent run.
#HOT_MEMORY=true
#HOT_MEMORY_TTL=1h

# ── Dreaming: autonomous memory consolidation on an interval ───────────
# Deterministic signals decide if there's anything to do — a healthy memory
# costs nothing. Unset DREAM_INTERVAL disables dreaming entirely; the minimum
# is 5m. The first run happens one interval after boot, never at startup.
DREAM_INTERVAL=6h

# Which signals may trigger a consolidation pass:
#   orphans    concepts nothing links to        → wire them in
#   links      broken links                     → fix or remove
#   oversized  concepts grown fat               → split hub-and-spoke
#   insights   emergent themes in recent log    → create one overview concept
#   duplicates near-identical concepts          → MERGE AND DELETE one
#
# Default is everything except `duplicates`. It is the only signal that
# deletes, and it fires on title/description string similarity — the measure
# most likely to be wrong. Mutations are transactional and git-committed, so a
# bad merge is revertible, but only if you notice. Turn it on with
# DREAM_SIGNALS=all once the other signals look right on your bundle.
#DREAM_SIGNALS=orphans,links,oversized,insights

# Most concepts one dream may change (create, edit and delete all count). A run
# that changes more is rolled back in full and reported as too_broad. Every
# dream commit starts with "dream:"; /api/dream/status gives a command that
# reverts exactly one run.
#DREAM_MAX_CHANGES=15

# Legacy toggle, still honoured: removes `insights` from whatever is enabled.
#DREAM_INSIGHTS=true
